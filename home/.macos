#!/usr/bin/env bash

# ~/.macos - based on https://mths.be/macos

# Close any open settings panes before changing preferences.
osascript -e 'tell application "System Settings" to quit' 2>/dev/null || true
osascript -e 'tell application "System Preferences" to quit' 2>/dev/null || true

###############################################################################
# General UI/UX                                                               #
###############################################################################

# Use dark mode.
defaults write NSGlobalDomain AppleInterfaceStyle -string "Dark"

# Disable automatic light/dark mode switching.
defaults write NSGlobalDomain AppleInterfaceStyleSwitchesAutomatically -bool false

# Expand save panel by default.
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode -bool true
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode2 -bool true

# Save to disk, not iCloud, by default.
defaults write NSGlobalDomain NSDocumentSaveNewDocumentsToCloud -bool false

# Disable Resume system-wide.
defaults write NSGlobalDomain NSQuitAlwaysKeepsWindows -bool false

# Disable typing substitutions that are hostile to code, commands, and snippets.
defaults write NSGlobalDomain NSAutomaticCapitalizationEnabled -bool false
defaults write NSGlobalDomain NSAutomaticDashSubstitutionEnabled -bool false
defaults write NSGlobalDomain NSAutomaticPeriodSubstitutionEnabled -bool false
defaults write NSGlobalDomain NSAutomaticQuoteSubstitutionEnabled -bool false
defaults write NSGlobalDomain NSAutomaticSpellingCorrectionEnabled -bool false

# Enable full keyboard access for all controls, e.g. Tab in modal dialogs.
defaults write NSGlobalDomain AppleKeyboardUIMode -int 3

# Disable press-and-hold for keys in favor of key repeat.
defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool false

# Fast keyboard repeat for developer workflows.
defaults write NSGlobalDomain KeyRepeat -int 1
defaults write NSGlobalDomain InitialKeyRepeat -int 10

# Disable user interface sound effects, including Finder trash sounds.
# Mirrors System Settings > Sound > Play user interface sound effects.
defaults write NSGlobalDomain "com.apple.sound.uiaudio.enabled" -int 0

# Disable startup chime.
# Mirrors System Settings > Sound > Play sound on startup.
sudo nvram "StartupMute=%01" 2>/dev/null || true

###############################################################################
# Security                                                                    #
###############################################################################

# Require password immediately after sleep or screensaver begins.
defaults write com.apple.screensaver askForPassword -int 1
defaults write com.apple.screensaver askForPasswordDelay -int 0

###############################################################################
# Finder                                                                      #
###############################################################################

# Show all filename extensions.
defaults write NSGlobalDomain AppleShowAllExtensions -bool true

# Show Finder status bar and path bar.
defaults write com.apple.finder ShowStatusBar -bool true
defaults write com.apple.finder ShowPathbar -bool true

# Keep folders on top when sorting by name.
defaults write com.apple.finder _FXSortFoldersFirst -bool true

# When performing a search, search the current folder by default.
defaults write com.apple.finder FXDefaultSearchScope -string "SCcf"

# Disable the warning when changing a file extension.
defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false

# Automatically resize Finder column view widths to fit visible filenames.
defaults write com.apple.finder _FXEnableColumnAutoSizing -bool true

# Enable spring loading for directories and remove the delay.
defaults write NSGlobalDomain com.apple.springing.enabled -bool true
defaults write NSGlobalDomain com.apple.springing.delay -float 0

# Avoid creating .DS_Store files on network and USB volumes.
defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true
defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true

# Automatically open a new Finder window when a volume is mounted.
defaults write com.apple.frameworks.diskimages auto-open-ro-root -bool true
defaults write com.apple.frameworks.diskimages auto-open-rw-root -bool true
defaults write com.apple.finder OpenWindowForNewRemovableDisk -bool true

# Enable snap-to-grid for desktop icons if the Finder preferences structure exists.
/usr/libexec/PlistBuddy -c "Set :DesktopViewSettings:IconViewSettings:arrangeBy grid" "$HOME/Library/Preferences/com.apple.finder.plist" 2>/dev/null || true

# Disable the warning before emptying the Trash.
defaults write com.apple.finder WarnOnEmptyTrash -bool false

# Show the ~/Library folder.
chflags nohidden "$HOME/Library" 2>/dev/null || true

###############################################################################
# Dock and Mission Control                                                     #
###############################################################################

# Automatically hide and show the Dock.
defaults write com.apple.dock autohide -bool true

# Remove the auto-hiding Dock delay and animation.
defaults write com.apple.dock autohide-delay -float 0
defaults write com.apple.dock autohide-time-modifier -float 0

# Do not show recent applications in the Dock.
defaults write com.apple.dock show-recents -bool false

# Do not automatically rearrange Spaces based on most recent use.
defaults write com.apple.dock mru-spaces -bool false

###############################################################################
# Screenshots                                                                 #
###############################################################################

# Disable shadow in screenshots.
defaults write com.apple.screencapture disable-shadow -bool true

# Disable the floating screenshot thumbnail.
defaults write com.apple.screencapture show-thumbnail -bool false

###############################################################################
# Mail                                                                        #
###############################################################################

# Disable send and reply animations in Mail.app.
defaults write com.apple.mail DisableReplyAnimations -bool true
defaults write com.apple.mail DisableSendAnimations -bool true

# Copy email addresses as foo@example.com instead of Foo Bar <foo@example.com>.
defaults write com.apple.mail AddressesIncludeNameOnPasteboard -bool false

# Add Cmd+Enter to send mail.
defaults write com.apple.mail NSUserKeyEquivalents -dict-add "Send" "@\U21a9"

# Display emails in threaded mode, sorted by date.
defaults write com.apple.mail DraftsViewerAttributes -dict-add "DisplayInThreadedMode" -string "yes"
defaults write com.apple.mail DraftsViewerAttributes -dict-add "SortedDescending" -string "yes"
defaults write com.apple.mail DraftsViewerAttributes -dict-add "SortOrder" -string "received-date"

# Disable inline attachments.
defaults write com.apple.mail DisableInlineAttachmentViewing -bool true

###############################################################################
# Apple Intelligence                                                           #
###############################################################################

# The real opt-out happens in Setup Assistant ("Not now" on Apple Intelligence),
# which records com.apple.CloudSubscriptionFeatures.optIn opted_out_buddy and
# skips the model download. Everything below is belt-and-suspenders.

# Unverified blog key; not present on macOS 27. Kept because it is harmless.
defaults write com.apple.CloudSubscriptionFeatures.optIn "545129924" -bool false

# Disable notification summaries.
# Mirrors System Settings > Notifications > Summarize Notifications.
defaults write com.apple.ncprefs summarize_previews -bool false

# Disable Genmoji suggestions in the emoji picker.
defaults write com.apple.EmojiPreferences GenmojiSuggestions -bool false

###############################################################################
# Siri                                                                        #
###############################################################################

# Disable Siri, its menu bar item, and "Hey Siri".
defaults write com.apple.assistant.support "Assistant Enabled" -bool false
defaults write com.apple.Siri StatusMenuVisible -bool false
defaults write com.apple.Siri VoiceTriggerUserEnabled -bool false
defaults write com.apple.assistant.backedup "Cloud Sync Enabled" -bool false

# Globe/fn key does nothing (no accidental dictation, emoji, or Siri).
defaults write com.apple.HIToolbox AppleFnUsageType -int 0

###############################################################################
# Privacy and telemetry                                                       #
###############################################################################

# Disable personalized ads and the advertising identifier.
defaults write com.apple.AdLib allowApplePersonalizedAdvertising -bool false
defaults write com.apple.AdLib allowIdentifierForAdvertising -bool false
defaults write com.apple.AdLib forceLimitAdTracking -bool true

# Do not send diagnostics to Apple or app developers.
# Mirrors System Settings > Privacy & Security > Analytics & Improvements.
DIAG_PLIST="/Library/Application Support/CrashReporter/DiagnosticMessagesHistory.plist"
sudo defaults write "$DIAG_PLIST" AutoSubmit -bool false 2>/dev/null || true
sudo defaults write "$DIAG_PLIST" ThirdPartyDataSubmit -bool false 2>/dev/null || true

# Disable Game Center.
defaults write com.apple.gamed Disabled -bool true

###############################################################################
# Desktop and window manager                                                  #
###############################################################################

# Hide desktop widgets in standard and Stage Manager modes.
defaults write com.apple.WindowManager StandardHideWidgets -bool true
defaults write com.apple.WindowManager StageManagerHideWidgets -bool true

# Clicking the wallpaper does not hide all windows.
defaults write com.apple.WindowManager EnableStandardClickToShowDesktop -bool false

###############################################################################
# Notes                                                                       #
###############################################################################

# Trash retention: Finder only exposes a supported 30-day auto-empty setting:
#   defaults write com.apple.finder FXRemoveOldTrashItems -bool true
# Do not enable it here because the desired retention is 90 days. Use a separate
# LaunchAgent/script if 90-day cleanup is required.

###############################################################################
# Restart Affected Applications                                                #
###############################################################################

for app in \
  "cfprefsd" \
  "ControlCenter" \
  "Dock" \
  "Finder" \
  "Mail" \
  "Music" \
  "Safari" \
  "SystemUIServer" \
  "WindowManager"; do
  killall "$app" > /dev/null 2>&1 || true
done

echo "Done. Some changes may require a logout or restart to take effect."
