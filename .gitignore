.DS_Store
npm-debug.log
*.local
*.local.*
!.local/
**/.local/*
!**/.local/bin/

# Claude Code: only portable status-line files are tracked.
home/.claude/*
!home/.claude/statusline.json
!home/.claude/statusline.sh

# Pi agent: only hand-written config/extensions are tracked; never credentials or state.
home/.pi/agent/auth.json
home/.pi/agent/mcp*.json
home/.pi/agent/models*.json
home/.pi/agent/sessions/
home/.pi/agent/subagent-logs/
home/.pi/agent/git/
home/.pi/agent/npm/
home/.pi/agent/settings.json.lock
home/.pi/agent/workflow/verification/
